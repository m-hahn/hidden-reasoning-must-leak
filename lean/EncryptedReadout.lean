import ReadoutSchedule
import ProtocolEncryptedBinary
import ProtocolSerialization

/-!
# A whole plaintext output word after encrypted binary reasoning

Output heads read public selected payload positions and their local PRG seed
neighborhoods. A fixed finite transition decrypts these bits and emits one
plaintext answer packet per output coordinate. The payload, separator, and
all output bits are generated by the same numerical matrix model.
-/

noncomputable section
namespace EncryptedReadout
open TransformerAC0 Encryption RoutedSchedule
variable {front steps extra heads opcodes width seedLength locality : ℕ}

def readHeads (width locality : ℕ) := width + width * locality
def bitHead (bit : Fin width) : Fin (readHeads width locality) := Fin.castAdd (width * locality) bit
def seedHead (bit : Fin width) (index : Fin locality) : Fin (readHeads width locality) :=
  Fin.natAdd width (finProdFinEquiv (bit, index))

abbrev Rules (width locality : ℕ) := Fin width → Bits locality → Bool
noncomputable instance rulesFintype (width locality : ℕ) : Fintype (Rules width locality) := Fintype.ofFinite _
def readOpcodes (width locality : ℕ) := Fintype.card (Rules width locality)
def ruleCode : Rules width locality ≃ Fin (readOpcodes width locality) := Fintype.equivFin _

def readouts (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) :
    ReadoutSchedule.Readouts (seedLength + front) steps extra (readHeads width locality) (readOpcodes width locality) where
  source output := Fin.addCases
    (fun bit => Fin.natAdd (seedLength + front) (sources output bit))
    (fun index =>
      let pair := finProdFinEquiv.symm index
      ⟨(generator.dependency (sources output pair.1).castSucc pair.2).val, by
        have hi := (generator.dependency (sources output pair.1).castSucc pair.2).isLt
        omega⟩)
  opcode output := ruleCode (fun bit => generator.truthTable (sources output bit).castSucc)

def transition (decode : Bits width → Bool) (opcode : Fin (readOpcodes width locality))
    (selected : Fin (readHeads width locality) → Fin (EncryptedMatrix.packetCount 2)) : Fin (EncryptedMatrix.packetCount 2) :=
  EncryptedMatrix.answerPacket 2 (decode (fun bit => xor
    (EncryptedMatrix.cipherValue (selected (bitHead bit)) 1)
    (ruleCode.symm opcode bit (fun index => EncryptedMatrix.seedValue (selected (seedHead bit index))))))

def schedule (original : Schedule front steps heads opcodes)
    (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) :=
  ReadoutSchedule.schedule (ProtocolEncryptedBinary.baseSchedule original generator) (readouts generator sources)

def run (original : Fin opcodes → (Fin heads → Fin 2) → Fin 2) (decode : Bits width → Bool) :=
  ReadoutSchedule.transition (ProtocolEncryptedBinary.run (locality := locality) original (fun _ => false))
    (transition (locality := locality) decode)

def prefixWord (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality) (plain : Fin front → Fin 2) (seed : Bits seedLength) :=
  word (EncryptedMatrix.prompt plain seed) steps (fun time =>
    token (ProtocolEncryptedBinary.baseSchedule original generator)
      (ProtocolEncryptedBinary.run originalTransition (fun _ => false)) (EncryptedMatrix.prompt plain seed) time.castSucc)

theorem base_payload (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality) (plain : Fin front → Fin 2) (seed : Bits seedLength) (time : Fin steps) :
    token (ProtocolEncryptedBinary.baseSchedule original generator)
      (ProtocolEncryptedBinary.run originalTransition (fun _ => false)) (EncryptedMatrix.prompt plain seed) time.castSucc =
      EncryptedBinaryMatrix.binaryPacket
        (xor (EncryptedBinaryMatrix.plainTranscript original originalTransition plain time) (generator.generate seed time.castSucc)) := by
  rw [ProtocolEncryptedBinary.base_correct]
  have hnot : time.castSucc.val ≠ steps := by have ht := time.isLt; change time.val ≠ steps; omega
  simp only [EncryptedMatrix.target, hnot, ↓reduceIte, EncryptedBinaryMatrix.repeat_pad, EncryptedBinaryMatrix.xor_indicator]
  rfl

@[simp] theorem cipher_binaryPacket (bit : Bool) :
    EncryptedMatrix.cipherValue (EncryptedBinaryMatrix.binaryPacket bit) 1 = bit := by
  cases bit <;> simp [EncryptedBinaryMatrix.binaryPacket, RoutedMatrix.indicator, BinarySchedule.bitToken]

theorem read_bit (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) (plain : Fin front → Fin 2) (seed : Bits seedLength)
    (output : Fin (extra + 1)) (bit : Fin width) :
    EncryptedMatrix.cipherValue
      (prefixWord original originalTransition generator plain seed ((readouts (front := front) generator sources).source output (bitHead bit))) 1 =
      xor (EncryptedBinaryMatrix.plainTranscript original originalTransition plain (sources output bit))
        (generator.generate seed (sources output bit).castSucc) := by
  simp only [readouts, bitHead, Fin.addCases_left, prefixWord, word, Fin.addCases_right, base_payload, cipher_binaryPacket]

theorem read_seed (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) (plain : Fin front → Fin 2) (seed : Bits seedLength)
    (output : Fin (extra + 1)) (bit : Fin width) (index : Fin locality) :
    EncryptedMatrix.seedValue
      (prefixWord original originalTransition generator plain seed
        ((readouts (front := front) generator sources).source output (seedHead bit index))) =
      seed (generator.dependency (sources output bit).castSucc index) := by
  have hsource : (readouts (front := front) generator sources).source output (seedHead bit index) =
      Fin.castAdd steps (Fin.castAdd front (generator.dependency (sources output bit).castSucc index)) := by
    apply Fin.ext
    simp only [readouts, seedHead, Fin.addCases_right, Equiv.symm_apply_apply]
    rfl
  rw [hsource]
  simp [prefixWord, word, EncryptedMatrix.prompt]

theorem transition_correct (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) (decode : Bits width → Bool)
    (plain : Fin front → Fin 2) (seed : Bits seedLength) (output : Fin (extra + 1)) :
    transition decode ((readouts (front := front) generator sources).opcode output)
      (fun head => prefixWord original originalTransition generator plain seed
        ((readouts (front := front) generator sources).source output head)) =
      EncryptedMatrix.answerPacket 2 (decode (fun bit =>
        EncryptedBinaryMatrix.plainTranscript original originalTransition plain (sources output bit))) := by
  have hop : (readouts (front := front) generator sources).opcode output =
      ruleCode (fun bit => generator.truthTable (sources output bit).castSucc) := rfl
  simp only [transition, hop, Equiv.symm_apply_apply]
  congr 2
  funext bit
  rw [read_bit]
  have hmask : (fun index => EncryptedMatrix.seedValue
      (prefixWord original originalTransition generator plain seed
        ((readouts (front := front) generator sources).source output (seedHead bit index)))) =
      generator.localInput (sources output bit).castSucc seed := by
    funext index
    exact read_seed original originalTransition generator sources plain seed output bit index
  rw [hmask, generator.truthTable_correct]
  simp [Bool.xor_assoc]

def model (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) (decode : Bits width → Bool) :=
  ProtocolMatrix.model (schedule original generator sources) (EncryptedMatrix.packet_positive 2)
    (run (locality := locality) originalTransition decode) EncryptedMatrix.answerValue steps (by omega)

theorem payload_correct (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) (decode : Bits width → Bool)
    (plain : Fin front → Fin 2) (seed : Bits seedLength) (time : Fin steps) :
    (model original originalTransition generator sources decode).generatedToken
      (ProtocolEncryptedBinary.inputEncoding plain seed) ⟨time.val, by have h := time.isLt; omega⟩ =
      ProtocolMatrix.dataToken (EncryptedBinaryMatrix.binaryPacket
        (xor (EncryptedBinaryMatrix.plainTranscript original originalTransition plain time) (generator.generate seed time.castSucc))) := by
  rw [model, ProtocolEncryptedBinary.inputEncoding, ProtocolMatrix.generated_correct]
  have hnot : time.val ≠ steps := by have ht := time.isLt; omega
  simp only [ProtocolMatrix.target, hnot, ↓reduceIte]
  have ht : ProtocolMatrix.oldTime (steps := steps + extra) steps (by omega) ⟨time.val, by have h := time.isLt; omega⟩ =
      ReadoutSchedule.extendTime (extra := extra) time := by
    apply Fin.ext
    simp [ProtocolMatrix.oldTime, ReadoutSchedule.extendTime, Nat.le_of_lt time.isLt]
  rw [ht, schedule, run, ReadoutSchedule.prefix_correct, base_payload]

theorem output_correct (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) (decode : Bits width → Bool)
    (plain : Fin front → Fin 2) (seed : Bits seedLength) (output : Fin (extra + 1)) :
    (model original originalTransition generator sources decode).generatedToken
      (ProtocolEncryptedBinary.inputEncoding plain seed) ⟨steps + 1 + output.val, by have h := output.isLt; omega⟩ =
      ProtocolMatrix.dataToken (EncryptedMatrix.answerPacket 2 (decode (fun bit =>
        EncryptedBinaryMatrix.plainTranscript original originalTransition plain (sources output bit)))) := by
  rw [model, ProtocolEncryptedBinary.inputEncoding, ProtocolMatrix.generated_correct]
  have hnot : steps + 1 + output.val ≠ steps := by omega
  simp only [ProtocolMatrix.target, hnot, ↓reduceIte]
  have ht : ProtocolMatrix.oldTime (steps := steps + extra) steps (by omega)
      ⟨steps + 1 + output.val, by have h := output.isLt; omega⟩ = ⟨steps + output.val, by have h := output.isLt; omega⟩ := by
    apply Fin.ext
    simp [ProtocolMatrix.oldTime, show ¬steps + 1 + output.val ≤ steps by omega]
  rw [ht, schedule, run, ReadoutSchedule.read_correct]
  exact congrArg ProtocolMatrix.dataToken (transition_correct original originalTransition generator sources decode plain seed output)

theorem separator_generated (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) (decode : Bits width → Bool)
    (plain : Fin front → Fin 2) (seed : Bits seedLength) :
    (model original originalTransition generator sources decode).generatedToken
      (ProtocolEncryptedBinary.inputEncoding plain seed) ⟨steps, by omega⟩ =
      ProtocolMatrix.separator (EncryptedMatrix.packetCount 2) :=
  ProtocolMatrix.separator_generated _ _ _ _ _ _ _

/-- The monitored word stops at the separator; none of the plaintext output
suffix is accidentally included in the reasoning transcript. -/
def encodedTrace (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) (decode : Bits width → Bool)
    (encoding : ProtocolSerialization.Encoding codeWidth) (plain : Fin front → Fin 2) (seed : Bits seedLength) :
    Bits ((steps + 1) * codeWidth) := fun wire =>
  let pair := finProdFinEquiv.symm wire
  encoding ((model original originalTransition generator sources decode).generatedToken
    (ProtocolEncryptedBinary.inputEncoding plain seed)
    (Fin.castLE (by omega : steps + 1 ≤ steps + extra + 2) pair.1)) pair.2

theorem encodedTrace_eq_original (original : Schedule front steps heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (generator : LocalGenerator seedLength (steps + 1) locality)
    (sources : Fin (extra + 1) → Fin width → Fin steps) (decode : Bits width → Bool)
    (encoding : ProtocolSerialization.Encoding codeWidth) (plain : Fin front → Fin 2) (seed : Bits seedLength) :
    encodedTrace original originalTransition generator sources decode encoding plain seed =
      ProtocolSerialization.transcript original originalTransition (fun _ => false) generator encoding plain seed := by
  funext wire
  obtain ⟨⟨position, bit⟩, rfl⟩ := finProdFinEquiv.surjective wire
  simp only [encodedTrace, ProtocolSerialization.transcript, Equiv.symm_apply_apply, CausalAutoregressive.Model.transcript]
  refine Fin.lastCases ?_ (fun position => ?_) position
  · exact congrArg (fun packet => encoding packet bit)
      ((separator_generated original originalTransition generator sources decode plain seed).trans
        (ProtocolEncryptedBinary.separator_generated original originalTransition (fun _ => false) generator plain seed).symm)
  · exact congrArg (fun packet => encoding packet bit)
      ((payload_correct original originalTransition generator sources decode plain seed position).trans
        (ProtocolEncryptedBinary.payload_correct original originalTransition (fun _ => false) generator plain seed position).symm)

theorem no_readability {inputLength seedLengths fronts times extras : ℕ → ℕ}
    (originals : ∀ n, Schedule (fronts n) (times n) heads opcodes)
    (originalTransition : Fin opcodes → (Fin heads → Fin 2) → Fin 2)
    (sources : ∀ n, Fin (extras n + 1) → Fin width → Fin (times n)) (decode : Bits width → Bool)
    (prompts : ∀ n, Bits (inputLength n) → Fin (fronts n) → Fin 2)
    (generator : NC0GeneratorFamily seedLengths (fun n => times n + 1)) (secure : generator.IsPseudorandom)
    (encoding : ProtocolSerialization.Encoding codeWidth)
    (monitor : PolynomialMonitorFamily (fun n => (times n + 1) * codeWidth))
    (coefficient exponent : ℕ) (timeLength : ∀ n, times n ≤ coefficient * (n + 1) ^ exponent) :
    ∃ error : ℕ → ℝ, Negligible error ∧ ∀ n
      (distribution : FiniteDistribution (Bits (inputLength n))) (predicate : Bits (inputLength n) → Bool),
      predictionSuccess distribution
        (fun input seed => encodedTrace (originals n) originalTransition (generator.generator n) (sources n) decode encoding (prompts n input) seed)
        (monitor.monitor n) predicate ≤ distribution.bestConstantSuccess predicate + error n := by
  simp_rw [encodedTrace_eq_original]
  exact ProtocolSerialization.no_readability originals originalTransition (fun _ => false) prompts generator secure
    encoding monitor coefficient exponent timeLength

end EncryptedReadout
